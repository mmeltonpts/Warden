# Warden bootstraps — THREE secrets and nothing else.
#
# Everything an operator might plausibly want different lives in the database and the
# Settings UI. These three are here only because they must exist before the database can
# be read at all. Anything else in this file is a bug.

DATABASE_URL="postgresql://warden:CHANGEME@localhost:5432/warden?schema=public"

# Signs session cookies.            openssl rand -hex 32
SESSION_SECRET="generate-with-openssl-rand-hex-32"

# Unwraps every encrypted settings value (AES-256-GCM). Lose it and every saved
# credential must be re-entered.      openssl rand -hex 32
WARDEN_MASTER_KEY="generate-with-openssl-rand-hex-32"


# NOTE: WARDEN_ALLOW_DESTRUCTIVE is deliberately NOT in this file.
#
# It gates district-wide mail deletion. This file is owned by the application user, so
# anything that can run code as that user could flip it — which would make it decorative.
# It lives in a root-owned systemd drop-in instead:
#
#   /etc/systemd/system/warden-web.service.d/10-destructive.conf
#
# deploy/install.sh creates it, closed. Changing it needs root and a service restart.
